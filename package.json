{
	"name": "diegog.io",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=24",
		"pnpm": ">=11"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"icons": "node scripts/fetch-icons.ts",
		"prepare": "lefthook install || true"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@mdx-js/loader": "^3.1.1",
		"@mdx-js/react": "^3.1.1",
		"@next/mdx": "^16.4.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.72.0",
		"next": "^16.4.6",
		"p5": "~2.3.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@playwright/test": "^1.65.0",
		"@tailwindcss/postcss": "^4.3.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.10",
		"@types/mdx": "^2.0.14",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/coverage-v8": "^4.1.12",
		"jsdom": "^30.1.3",
		"lefthook": "^2.2.2",
		"shadcn": "^4.23.0",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	}
}
