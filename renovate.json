{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", ":dependencyDashboard", ":semanticCommits", "schedule:weekly"],
	"labels": ["dependencies"],
	"lockFileMaintenance": { "enabled": true },
	"packageRules": [
		{
			"description": "Auto-merge low-risk updates once CI is green",
			"matchUpdateTypes": ["minor", "patch"],
			"matchCurrentVersion": "!/^0/",
			"automerge": true
		},
		{
			"description": "Next and React must move together",
			"groupName": "next + react",
			"matchPackageNames": [
				"next",
				"react",
				"react-dom",
				"@types/react",
				"@types/react-dom",
				"@next/third-parties"
			]
		},
		{
			"description": "Tailwind core and its PostCSS plugin are version-locked",
			"groupName": "tailwind",
			"matchPackageNames": ["tailwindcss", "@tailwindcss/postcss", "tw-animate-css"]
		},
		{
			"description": "Playwright's package and its browsers ship in lockstep",
			"groupName": "playwright",
			"matchPackageNames": ["@playwright/test", "playwright"]
		},
		{
			"description": "p5 2.4 fetches FES translations from cdn.jsdelivr.net on load, breaking the no-third-party-requests guarantee; revisit when that can be disabled",
			"matchPackageNames": ["p5"],
			"allowedVersions": "<2.4.0"
		}
	]
}
